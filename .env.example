# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_server_key_here

# OpenAI server-side settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local/demo mode. Keep false in production.
DEMO_MODE=true
ENABLE_DEMO_SEED=true
DEMO_FIRM_ID=00000000-0000-0000-0000-000000000001
DEMO_USER_ID=00000000-0000-0000-0000-000000000002
DEMO_USER_EMAIL=demo-admin@examplelawfirm.com
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Web/general chat mode uses OpenAI's hosted web_search_preview tool through the Responses API.
# No separate web-search key is required, but your OpenAI API account must have quota.

# Optional demo persona fields
DEMO_USER_DISPLAY_NAME=Demo Admin
DEMO_USER_PRACTICE_AREA=General
DEMO_USER_CHATBOT_PERSONA=Treat this user as the firm owner/admin. Give concise implementation and workflow guidance.
